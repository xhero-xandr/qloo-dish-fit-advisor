QLOO_API_KEY=your_qloo_hackathon_key
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Optional: enables the model-driven agent layer. Without a usable model the app runs the deterministic pipeline only.
# Models, tried in order, comma-separated. A bare name is a Google Gemini model (key: GEMINI_API_KEY);
# "<provider>:<model>" is any OpenAI-compatible provider (key: <PROVIDER>_API_KEY, address: <PROVIDER>_BASE_URL,
# built in for openai, groq, openrouter, deepseek, mistral, together, anthropic and ollama). Default: gemini-3.5-flash-lite.
GEMINI_API_KEY=your_gemini_api_key
# LLM_MODELS=gemini-3.5-flash-lite
# LLM_MODELS=google:gemini-3.5-flash-lite,groq:llama-3.3-70b-versatile
# GROQ_API_KEY=your_groq_key
# Optional: turns on the demo login for /api/analyze when DEMO_PASSWORD is set (username from DEMO_USER or DEMO_USERNAME, default "demo").
# DEMO_USER=demo
# DEMO_PASSWORD=choose-a-password
# Optional: signs the session cookie (defaults to DEMO_PASSWORD); set SHOW_DEMO_CREDENTIALS=0 to hide the demo account on the login page.
# SESSION_SECRET=a-long-random-string
# SHOW_DEMO_CREDENTIALS=1
# Optional: limits per client address, per hour (defaults 30 and 20). Raise them when many people share one address.
# ANALYSES_PER_HOUR=30
# MENU_READS_PER_HOUR=20
# Optional: how long identical concept+city results are reused, in minutes (default 720).
# PILOT_CACHE_TTL_MINUTES=720

# Optional: log every outbound Qloo request (path and type) to the server console, to count calls per analysis.
# QLOO_LOG=1
