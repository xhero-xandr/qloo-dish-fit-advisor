QLOO_API_KEY=your_qloo_hackathon_key
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Optional: enables the Gemini agent layer. Without it the app runs the deterministic pipeline only.
GEMINI_API_KEY=your_gemini_api_key
# Optional: model fallback chain, tried in order (default: gemini-3.5-flash-lite).
# GEMINI_MODELS=gemini-3.5-flash-lite
# Optional: backup for the analysis step once Gemini's quota is spent (Groq free tier).
# GROQ_API_KEY=your_groq_api_key
# Optional: Groq models, tried in order (default: openai/gpt-oss-120b).
# GROQ_MODELS=openai/gpt-oss-120b
# Optional: how long identical concept+city results are reused, in minutes (default 720).
# PILOT_CACHE_TTL_MINUTES=720
